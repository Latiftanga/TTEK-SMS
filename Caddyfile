# Plain-HTTP routing for the production compose stack (docker-compose.prod.yml).
# :80 (not a domain) means Caddy never attempts automatic HTTPS here — see
# DEPLOY.md for how to point a real domain at this once one exists, at which
# point replacing ":80" with the real domain is a one-line change that turns
# on automatic Let's Encrypt HTTPS with no other code involved.
:80 {
	# handle_path (not handle) strips the /api prefix before proxying — the
	# backend's own routes are registered without it (e.g. /attendance/...,
	# not /api/attendance/...); in dev this stripping is done by Vite's own
	# proxy (vite.config.ts: rewrite: path => path.replace(/^\/api/, '')),
	# which has no equivalent once the frontend is a built adapter-node app.
	handle_path /api/* {
		# Hard cap on request body size at the edge, before it ever reaches
		# the backend — the app-level check in routers/documents.py can only
		# reject an oversized upload after Content-Length is inspected (or,
		# for a client that lies/omits it, after the body has already been
		# received), so this is the one place a truly early abort is
		# possible. 10 MB is the real per-file limit (documents.py's
		# MAX_FILE_BYTES); the extra room here is multipart boundary/header
		# overhead, not a separate policy.
		request_body {
			max_size 11MB
		}
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
