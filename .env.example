# TTEK-SMS Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env — only .env.example is tracked.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development               # development | staging | production
APP_SECRET_KEY=change-me-to-a-long-random-string-in-production
APP_DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ttek_sms
POSTGRES_USER=ttek
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://ttek:changeme@db:5432/ttek_sms

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ── File storage ─────────────────────────────────────────────────────────────
STORAGE_BACKEND=LOCAL             # LOCAL | CLOUDFLARE_R2
LOCAL_UPLOAD_DIR=./uploads        # mounted as a PUBLIC static route (logos, student/staff photos)
SECURE_UPLOAD_DIR=./secure_uploads  # never mounted — DocumentRecord files, bulk report-card ZIPs

# Cloudflare R2 (leave blank when STORAGE_BACKEND=LOCAL)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=                       # leave blank to disable

# ── HMAC (QR verification tokens) ────────────────────────────────────────────
HMAC_SECRET_KEY=change-me-to-another-long-random-string

# ── WeasyPrint ───────────────────────────────────────────────────────────────
# No config needed — uses system fonts in Docker

# ── ARQ worker ───────────────────────────────────────────────────────────────
# ARQ uses REDIS_URL above — no separate config needed

# ── First superadmin (seeded on first run) ────────────────────────────────────
SUPERADMIN_EMAIL=admin@tagnatek.com
SUPERADMIN_PASSWORD=changeme-immediately

# ── Multi-tenant routing ──────────────────────────────────────────────────────
# The platform's own domain — used by the frontend (hooks.server.ts) to
# distinguish platform subdomains (presec.your-domain.com) from school-owned
# custom domains (portal.presec.com), and by the backend to build the login
# link in report-published SMS/email text to guardians. Leave ALL THREE
# unset until you actually own a domain — there is no hardcoded fallback
# anywhere in the codebase, on purpose: local dev/testing against a school's
# subdomain works via *.localhost regardless (see CLAUDE.md "Testing a
# school's branded subdomain locally"), and setting any of these to a
# placeholder would build broken sign-in links and notification text
# pointing at a domain nobody owns. Once purchased, set all three to the
# real value below and redeploy — no code change needed.
# Read by both processes from this one shared .env file (see docker-compose.yml).
# SvelteKit server-only (frontend, hooks.server.ts): NOT exposed to the browser.
# Also read directly by the backend's Settings (core/config.py::platform_domain).
PLATFORM_DOMAIN=your-domain.com
# Vite public (frontend): available to client-side code for custom domain detection.
PUBLIC_PLATFORM_DOMAIN=your-domain.com
