# Production build — frontend/Dockerfile (dev) runs the Vite dev server;
# this runs the real adapter-node build (svelte.config.js already configures
# @sveltejs/adapter-node, it was just never invoked by any Dockerfile before).

# ── Build stage ──────────────────────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json* .
RUN npm config set fetch-retries 5 fetch-retry-mintimeout 20000 fetch-timeout 600000 \
    && npm ci

COPY . .
RUN npm run build

# ── Runtime stage ────────────────────────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app

# Production-only node_modules — adapter-node's build/ output needs the
# runtime deps (express-like server, ws, etc.) but none of the dev tooling
# (vite, svelte-check, eslint, ...) the build stage needed.
COPY package.json package-lock.json* .
RUN npm config set fetch-retries 5 fetch-retry-mintimeout 20000 fetch-timeout 600000 \
    && npm ci --omit=dev

COPY --from=build /app/build ./build

RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
    && chown -R appuser:appgroup /app
USER appuser

ENV PORT=3000
EXPOSE 3000

CMD ["node", "build/index.js"]
